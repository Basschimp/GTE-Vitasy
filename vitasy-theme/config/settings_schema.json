  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading Font",
        "default": "manrope_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body Font",
        "default": "inter_n4"
      }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "brand_logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "brand_logo_mobile",
        "label": "Logo (Mobile)"
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Brand Tagline",
        "default": "Science-Backed Supplements for Modern Health"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_twitter_link",
        "label": "Twitter URL"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube URL"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "TikTok URL"
      }
    ]
  },
  {
    "name": "Subscription",
    "settings": [
      {
        "type": "checkbox",
        "id": "subscription_enabled",
        "label": "Enable Subscriptions",
        "default": true
      },
      {
        "type": "text",
        "id": "subscription_discount",
        "label": "Subscription Discount (%)",
        "default": "10"
      },
      {
        "type": "richtext",
        "id": "subscription_benefits",
        "label": "Subscription Benefits",
        "default": "<p>Save money every order<br>Never run out<br>Cancel anytime</p>"
      }
    ]
  },
  {
    "name": "Reviews",
    "settings": [
      {
        "type": "checkbox",
        "id": "reviews_enabled",
        "label": "Enable Reviews",
        "default": true
      },
      {
        "type": "text",
        "id": "judge_me_public_key",
        "label": "Judge.me Public Key"
      }
