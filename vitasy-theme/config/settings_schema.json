    "theme_documentation_url": "https://help.shopify.com",
    "theme_support_url": "https://support.vitasysupplements.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary_navy",
        "label": "Primary Navy",
        "default": "#102A43"
      },
      {
        "type": "color",
        "id": "color_secondary_green",
        "label": "Secondary Green",
        "default": "#2BB673"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#F8FAFC"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#1F2937"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#E5E7EB"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Success",
        "default": "#22C55E"
      }
