  {
    "name": "Klaviyo",
    "settings": [
      {
        "type": "text",
        "id": "klaviyo_public_key",
        "label": "Klaviyo Public Key"
      }
    ]
  },
  {
    "name": "Analytics",
    "settings": [
      {
        "type": "text",
        "id": "analytics_ga4_id",
        "label": "GA4 Measurement ID",
        "placeholder": "G-XXXXXXXXXX"
      },
      {
        "type": "textarea",
        "id": "analytics_custom_script",
        "label": "Custom Analytics Script"
      }
    ]
  }
