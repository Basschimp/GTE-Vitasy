<div class="cart-page container" data-section-id="{{ section.id }}">
  <h1 class="cart-title" style="font-size: 2rem; margin-bottom: 2rem;">Your Cart</h1>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" id="cart-form">
      <div class="cart-items" style="margin-bottom: 2rem;">
        <table class="cart-table" style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="border-bottom: 1px solid #eee;">
              <th style="text-align: left; padding: 1rem; width: 50%;">Product</th>
              <th style="text-align: center; padding: 1rem;">Quantity</th>
              <th style="text-align: right; padding: 1rem;">Total</th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr class="cart-item" style="border-bottom: 1px solid #eee;">
                <td style="padding: 1rem;">
                  <div style="display: flex; gap: 1rem; align-items: center;">
                    {% if item.image %}
                      <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title | escape }}" style="width: 80px; height: 80px; object-fit: cover; border-radius: 4px;">
                    {% endif %}
                    <div>
                      <a href="{{ item.url }}" style="color: var(--color-text); text-decoration: none; font-weight: bold;">{{ item.product.title }}</a>
                      {% if item.variant.title != 'Default Title' %}
                        <p style="color: #666; font-size: 0.875rem; margin: 0.25rem 0 0 0;">{{ item.variant.title }}</p>
                      {% endif %}
                      <button type="button" class="remove-btn" data-line="{{ forloop.index }}" style="background: none; border: none; color: #ff4757; cursor: pointer; padding: 0; margin-top: 0.5rem; font-size: 0.875rem;">Remove</button>
                    </div>
                  </div>
                </td>
                <td style="padding: 1rem; text-align: center;">
                  <div style="display: inline-flex; align-items: center; gap: 0.5rem;">
                    <button type="button" class="qty-minus" data-line="{{ forloop.index }}" style="width: 32px; height: 32px; border: 1px solid #ddd; background: white; cursor: pointer;">-</button>
                    <input 
                      type="number" 
                      name="updates[]" 
                      value="{{ item.quantity }}" 
                      min="0" 
                      data-line="{{ forloop.index }}"
                      style="width: 60px; text-align: center; padding: 0.5rem; border: 1px solid #ddd;"
                    >
                    <button type="button" class="qty-plus" data-line="{{ forloop.index }}" style="width: 32px; height: 32px; border: 1px solid #ddd; background: white; cursor: pointer;">+</button>
                  </div>
                </td>
                <td style="padding: 1rem; text-align: right;">
                  {{ item.final_line_price | money }}
                  {% if item.original_line_price > item.final_line_price %}
                    <span style="display: block; color: #999; text-decoration: line-through; font-size: 0.875rem;">{{ item.original_line_price | money }}</span>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <!-- Order Notes -->
      {% if section.settings.show_notes %}
        <div class="cart-notes" style="margin-bottom: 2rem;">
          <label for="cart-note" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Order notes</label>
          <textarea 
            id="cart-note" 
            name="note" 
            placeholder="Special instructions for your order" 
            rows="3"
            style="width: 100%; padding: 1rem; border: 1px solid #ddd; border-radius: 4px;"
          >{{ cart.note }}</textarea>
        </div>
      {% endif %}

      <div class="cart-footer" style="display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; flex-wrap: wrap;">
        <div class="cart-actions" style="flex: 1;">
          <a href="/collections/all" class="button" style="display: inline-block; background: #f4f4f4; color: var(--color-text);">Continue Shopping</a>
        </div>

        <div class="cart-summary" style="min-width: 300px; padding: 1.5rem; background: #f9f9f9; border-radius: 4px;">
          <h3 style="margin-bottom: 1rem;">Order Summary</h3>
          
          <div class="summary-row" style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          
          {% if section.settings.show_discounts and cart.total_discount > 0 %}
            <div class="summary-row discount" style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; color: #22c55e;">
              <span>Discount</span>
              <span>-{{ cart.total_discount | money }}</span>
            </div>
          {% endif %}
          
          <div class="summary-row total" style="display: flex; justify-content: space-between; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #ddd; font-weight: bold; font-size: 1.25rem;">
            <span>Total</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          
          <p class="shipping-note" style="font-size: 0.875rem; color: #666; margin-top: 1rem;">
            Shipping & taxes calculated at checkout
          </p>

          <!-- Free Shipping Progress -->
          {% assign free_threshold = settings.cart_free_shipping_threshold | times: 100 %}
          {% assign remaining = free_threshold | minus: cart.total_price %}
          {% if remaining > 0 %}
            <div class="free-shipping-progress" style="margin-top: 1rem;">
              <p style="font-size: 0.875rem; color: #666; margin-bottom: 0.5rem;">
                Add {{ remaining | money }} more for free shipping!
              </p>
              <div style="background: #eee; height: 8px; border-radius: 4px; overflow: hidden;">
                <div style="background: var(--color-accent); height: 100%; width: {{ cart.total_price | times: 100.0 | divided_by: free_threshold }}%;"></div>
              </div>
            </div>
          {% else %}
            <p style="font-size: 0.875rem; color: #22c55e; margin-top: 1rem;">
              🎉 You've unlocked free shipping!
            </p>
          {% endif %}

          <button type="submit" name="checkout" class="button" style="width: 100%; margin-top: 1.5rem;">Proceed to Checkout</button>
          
          <!-- Express Checkout -->
          <div class="express-checkout" style="margin-top: 1rem;">
            {{ content_for_additional_checkout_buttons }}
          </div>
        </div>
      </div>
    </form>

    <!-- Upsell Products -->
    {% if section.settings.show_upsell %}
      <section class="cart-upsell" style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #eee;">
        <h2 style="text-align: center; margin-bottom: 2rem;">You May Also Like</h2>
        <div class="product-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem;">
          {% assign upsell_collection = collections['all'].products | limit: 4 %}
          {% for product in upsell_collection %}
            {% unless cart.contains_product_id == true %}
              {% render 'product-card', product: product %}
            {% endunless %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

  {% else %}
    <!-- Empty Cart State -->
    <div class="cart-empty" style="text-align: center; padding: 4rem 2rem;">
      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#ccc" style="margin-bottom: 1rem;">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>
      <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">Your cart is empty</h2>
      <p style="color: #666; margin-bottom: 2rem;">Looks like you haven't added anything to your cart yet.</p>
      <a href="/collections/all" class="button">Start Shopping</a>
    </div>
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const qtyInputs = document.querySelectorAll('.cart-item input[type="number"]');
    const removeBtns = document.querySelectorAll('.remove-btn');
    
    // Quantity controls
    document.querySelectorAll('.qty-minus').forEach(btn => {
      btn.addEventListener('click', function() {
        const line = this.dataset.line;
        const input = document.querySelector(`input[data-line="${line}"]`);
        if (parseInt(input.value) > 1) {
          input.value = parseInt(input.value) - 1;
          updateCart();
        }
      });
    });
    
    document.querySelectorAll('.qty-plus').forEach(btn => {
      btn.addEventListener('click', function() {
        const line = this.dataset.line;
        const input = document.querySelector(`input[data-line="${line}"]`);
        input.value = parseInt(input.value) + 1;
        updateCart();
      });
    });
    
    // Remove items
    removeBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const line = this.dataset.line;
        const input = document.querySelector(`input[data-line="${line}"]`);
        input.value = 0;
        updateCart();
      });
    });
    
    function updateCart() {
      document.getElementById('cart-form').submit();
    }
  });
</script>

{% schema %}
{
  "name": "Cart page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_upsell",
      "label": "Show upsell products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_notes",
      "label": "Show order notes",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discounts",
      "label": "Show discounts",
      "default": true
    }
  ]
}
{% endschema %}
