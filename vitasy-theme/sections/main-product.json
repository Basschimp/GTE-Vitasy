{
  "name": "Product page",
  "tag": "section",
  "class": "product-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_subscription",
      "label": "Show subscription options",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show reviews",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cross_sell",
      "label": "Show cross-sell products",
      "default": true
    },
    {
      "type": "range",
      "id": "cross_sell_limit",
      "label": "Number of cross-sell products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Product page"
    }
  ]
}
