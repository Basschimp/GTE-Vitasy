{%- style -%}
  .page {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .page__title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .page__content {
    line-height: 1.8;
  }

  .page__content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  @media screen and (max-width: 768px) {
    .page {
      padding: 2rem 1rem;
    }

    .page__title {
      font-size: 1.75rem;
    }
  }
{%- endstyle -%}

<div class="page">
  {% render 'breadcrumbs', page: page %}
  
  <h1 class="page__title">{{ page.title }}</h1>
  
  <div class="page__content">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
