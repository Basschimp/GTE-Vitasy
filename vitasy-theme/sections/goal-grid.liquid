{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  
  @media (max-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

<section class="section section-{{ section.id }}-padding">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section__heading" style="text-align: {{ section.settings.heading_alignment }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    
    {%- if section.settings.description != blank -%}
      <p class="section__description" style="text-align: {{ section.settings.heading_alignment }};">
        {{ section.settings.description }}
      </p>
    {%- endif -%}
    
    <div class="goal-grid">
      {%- for block in section.blocks -%}
        <a 
          href="{{ block.settings.link }}" 
          class="goal-card"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.icon != blank -%}
            <svg class="goal-card__icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              {{ block.settings.icon }}
            </svg>
          {%- elsif block.settings.image != blank -%}
            <img 
              src="{{ block.settings.image | image_url: width: 128 }}" 
              alt="{{ block.settings.title }}"
              class="goal-card__icon"
              width="64"
              height="64"
              loading="lazy"
            >
          {%- else -%}
            <svg class="goal-card__icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="32" cy="32" r="28" stroke="currentColor" stroke-width="2"/>
              <path d="M32 18V32L42 42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          {%- endif -%}
          
          {%- if block.settings.title != blank -%}
            <h3 class="goal-card__title">{{ block.settings.title }}</h3>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by Goal",
  "class": "goal-grid-section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Health Goal"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Find the perfect supplements for your specific health needs.</p>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (Desktop)",
      "min": 40,
      "max": 160,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (Desktop)",
      "min": 40,
      "max": 160,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 20,
      "max": 100,
      "step": 10,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 20,
      "max": 100,
      "step": 10,
      "default": 50,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "goal",
      "name": "Health Goal",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Sleep"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Link to collection or page"
        },
        {
          "type": "textarea",
          "id": "icon",
          "label": "SVG Icon Code",
          "info": "Paste SVG path data only"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon Image (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Goal",
      "blocks": [
        {
          "type": "goal",
          "settings": {
            "title": "Sleep",
            "link": "/collections/sleep"
          }
        },
        {
          "type": "goal",
          "settings": {
            "title": "Energy",
            "link": "/collections/energy"
          }
        },
        {
          "type": "goal",
          "settings": {
            "title": "Focus",
            "link": "/collections/focus"
          }
        },
        {
          "type": "goal",
          "settings": {
            "title": "Gut Health",
            "link": "/collections/gut-health"
          }
        },
        {
          "type": "goal",
          "settings": {
            "title": "Immunity",
            "link": "/collections/immunity"
          }
        },
        {
          "type": "goal",
          "settings": {
            "title": "Stress",
            "link": "/collections/stress"
          }
        },
        {
          "type": "goal",
          "settings": {
            "title": "Performance",
            "link": "/collections/performance"
          }
        },
        {
          "type": "goal",
          "settings": {
            "title": "Longevity",
            "link": "/collections/longevity"
          }
        }
      ]
    }
  ]
}
{% endschema %}
