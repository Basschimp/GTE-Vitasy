{%- style -%}
  .search-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .search-page__header {
    margin-bottom: 2rem;
  }

  .search-page__title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .search-page__form {
    display: flex;
    gap: 0.5rem;
    max-width: 600px;
  }

  .search-page__input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(var(--color-foreground), 0.3);
    border-radius: 4px;
    font-size: 1rem;
  }

  .search-page__input:focus {
    outline: none;
    border-color: rgb(var(--color-accent-1));
  }

  .search-page__button {
    padding: 0.75rem 1.5rem;
    background-color: rgb(var(--color-accent-1));
    color: rgb(var(--color-accent-2));
    border: none;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .search-page__button:hover {
    opacity: 0.9;
  }

  .search-page__tabs {
    display: flex;
    gap: 1rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
    margin-bottom: 2rem;
  }

  .search-page__tab {
    padding: 0.75rem 0;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    font-weight: 500;
    color: rgba(var(--color-foreground), 0.6);
    transition: all 0.2s ease;
  }

  .search-page__tab.active {
    color: rgb(var(--color-foreground));
    border-bottom-color: rgb(var(--color-accent-1));
  }

  .search-page__results {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .search-page__no-results {
    text-align: center;
    padding: 4rem 0;
  }

  .search-page__no-results-icon {
    width: 64px;
    height: 64px;
    color: rgba(var(--color-foreground), 0.3);
    margin: 0 auto 1.5rem;
  }

  @media screen and (max-width: 1024px) {
    .search-page__results {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .search-page {
      padding: 2rem 1rem;
    }

    .search-page__results {
      grid-template-columns: repeat(2, 1fr);
    }

    .search-page__form {
      flex-direction: column;
    }
  }
{%- endstyle -%}

<div class="search-page">
  <div class="search-page__header">
    <h1 class="search-page__title">{{ 'general.search.title' | t }}</h1>
    
    <form class="search-page__form" action="/search" method="get" role="search">
      <input 
        type="search" 
        name="q" 
        value="{{ search.terms | escape }}" 
        class="search-page__input"
        placeholder="{{ 'general.search.placeholder' | t }}"
        aria-label="Search"
      >
      <button type="submit" class="search-page__button">Search</button>
    </form>
  </div>

  {% if search.performed %}
    <div class="search-page__info">
      <p style="margin-bottom: 1.5rem; color: rgba(var(--color-foreground), 0.6);">
        {{ 'general.search.results_with_count.other' | t: count: search.results_count, terms: search.terms }}
      </p>
    </div>

    {% if search.results_count > 0 %}
      <div class="search-page__tabs">
        <button class="search-page__tab active" data-tab="products">Products ({{ search.results.products_count }})</button>
        <button class="search-page__tab" data-tab="pages">Pages ({{ search.results.pages_count }})</button>
        <button class="search-page__tab" data-tab="articles">Articles ({{ search.results.articles_count }})</button>
      </div>

      <div class="search-page__results" id="products-tab">
        {% for item in search.results.products limit: 12 %}
          {% render 'product-card', product: item %}
        {% endfor %}
      </div>
    {% else %}
      <div class="search-page__no-results">
        <svg class="search-page__no-results-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <h3>{{ 'general.search.no_results' | t: terms: search.terms }}</h3>
      </div>
    {% endif %}
  {% endif %}
</div>

<script>
  document.querySelectorAll('.search-page__tab').forEach(tab => {
    tab.addEventListener('click', function() {
      document.querySelectorAll('.search-page__tab').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      
      const targetTab = this.dataset.tab;
      // Tab switching logic can be expanded here
    });
  });
</script>

{% schema %}
{
  "name": "Search page",
  "settings": []
}
{% endschema %}
