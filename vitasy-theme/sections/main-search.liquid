<div class="search-page container" data-section-id="{{ section.id }}">
  <h1 class="search-title" style="font-size: 2rem; margin-bottom: 1rem;">Search Results</h1>
  
  <div class="search-form-wrapper" style="margin-bottom: 2rem;">
    <form action="/search" method="get" role="search" style="display: flex; gap: 0.5rem; max-width: 600px;">
      <input 
        type="search" 
        name="q" 
        value="{{ search.terms | escape }}" 
        placeholder="Search our store..." 
        aria-label="Search"
        style="flex: 1; padding: 1rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem;"
      >
      <button type="submit" class="button" style="padding: 1rem 2rem;">Search</button>
    </form>
  </div>

  {% if search.performed %}
    <p class="results-count" style="margin-bottom: 2rem; color: #666;">
      {{ search.results_count }} results for "{{ search.terms | escape }}"
    </p>

    <!-- Search Tabs -->
    <div class="search-tabs" style="display: flex; gap: 1rem; border-bottom: 1px solid #eee; margin-bottom: 2rem;">
      <button class="tab-btn active" data-tab="products" style="padding: 1rem; background: none; border: none; border-bottom: 2px solid var(--color-accent); cursor: pointer; font-weight: bold;">
        Products ({{ search.results.products.size }})
      </button>
      {% if section.settings.show_articles %}
        <button class="tab-btn" data-tab="articles" style="padding: 1rem; background: none; border: none; border-bottom: 2px solid transparent; cursor: pointer;">
          Articles ({{ search.results.articles.size }})
        </button>
      {% endif %}
      {% if section.settings.show_pages %}
        <button class="tab-btn" data-tab="pages" style="padding: 1rem; background: none; border: none; border-bottom: 2px solid transparent; cursor: pointer;">
          Pages ({{ search.results.pages.size }})
        </button>
      {% endif %}
    </div>

    <!-- Products Tab -->
    <div class="tab-content active" id="products-tab">
      {% if search.results.products.size > 0 %}
        <div class="product-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem;">
          {% for item in search.results.products %}
            {% render 'product-card', product: item %}
          {% endfor %}
        </div>
      {% else %}
        <p class="no-results" style="text-align: center; padding: 3rem; color: #666;">
          No products found matching your search.
        </p>
      {% endif %}
    </div>

    <!-- Articles Tab -->
    {% if section.settings.show_articles %}
      <div class="tab-content" id="articles-tab" style="display: none;">
        {% if search.results.articles.size > 0 %}
          <div class="article-list">
            {% for article in search.results.articles %}
              <article class="article-card" style="display: flex; gap: 1.5rem; margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #eee;">
                {% if article.image %}
                  <a href="{{ article.url }}" style="flex-shrink: 0;">
                    <img src="{{ article.image | image_url: width: 200 }}" alt="{{ article.title | escape }}" style="width: 150px; height: 100px; object-fit: cover; border-radius: 4px;">
                  </a>
                {% endif %}
                <div style="flex: 1;">
                  <h3 style="margin-bottom: 0.5rem;">
                    <a href="{{ article.url }}" style="color: var(--color-text); text-decoration: none;">{{ article.title }}</a>
                  </h3>
                  <p style="color: #666; font-size: 0.875rem; margin-bottom: 0.5rem;">
                    {{ article.published_at | date: '%B %d, %Y' }}
                  </p>
                  <p style="color: #666;">{{ article.excerpt | strip_html | truncate: 150 }}</p>
                </div>
              </article>
            {% endfor %}
          </div>
        {% else %}
          <p class="no-results" style="text-align: center; padding: 3rem; color: #666;">
            No articles found matching your search.
          </p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Pages Tab -->
    {% if section.settings.show_pages %}
      <div class="tab-content" id="pages-tab" style="display: none;">
        {% if search.results.pages.size > 0 %}
          <div class="page-list">
            {% for page in search.results.pages %}
              <div class="page-card" style="margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #eee;">
                <h3 style="margin-bottom: 0.5rem;">
                  <a href="{{ page.url }}" style="color: var(--color-text); text-decoration: none;">{{ page.title }}</a>
                </h3>
                <p style="color: #666;">{{ page.content | strip_html | truncate: 150 }}</p>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="no-results" style="text-align: center; padding: 3rem; color: #666;">
            No pages found matching your search.
          </p>
        {% endif %}
      </div>
    {% endif %}
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const tabId = this.dataset.tab;
        
        // Update active button
        tabBtns.forEach(b => {
          b.classList.remove('active');
          b.style.borderBottomColor = 'transparent';
          b.style.fontWeight = 'normal';
        });
        this.classList.add('active');
        this.style.borderBottomColor = 'var(--color-accent)';
        this.style.fontWeight = 'bold';
        
        // Show corresponding content
        tabContents.forEach(content => {
          content.style.display = 'none';
        });
        document.getElementById(tabId + '-tab').style.display = 'block';
      });
    });
  });
</script>

{% schema %}
{
  "name": "Search page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Show product results",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_articles",
      "label": "Show article results",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pages",
      "label": "Show page results",
      "default": true
    }
  ]
}
{% endschema %}
