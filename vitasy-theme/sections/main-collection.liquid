{%- comment -%}
  Main Collection Section
{%- endcomment -%}

<div class="collection-template">
  <div class="container">
    {%- render 'breadcrumbs', current: collection.title -%}

    <!-- Collection Hero -->
    <div class="collection-template__hero" style="padding: var(--spacing-12) 0; text-align: center;">
      <h1 class="collection-template__title">{{ collection.title }}</h1>

      {%- if collection.description != blank -%}
        <p class="collection-template__description" style="max-width: 600px; margin: var(--spacing-4) auto; color: var(--color-text);">
          {{ collection.description }}
        </p>
      {%- endif -%}
    </div>

    <!-- Filter & Sort -->
    <div class="collection-template__filters" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-8); padding: var(--spacing-4) 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
      <div class="collection-template__filter-count">
        {{ collection.products_count }} products
      </div>

      <div class="collection-template__sort">
        <select name="sort_by" id="SortBy" aria-label="Sort by" style="padding: var(--spacing-2) var(--spacing-4); border: 1px solid var(--color-border); border-radius: var(--radius-md);">
          <option value="manual">Featured</option>
          <option value="best-selling">Best Selling</option>
          <option value="title-ascending">Alphabetically, A-Z</option>
          <option value="title-descending">Alphabetically, Z-A</option>
          <option value="price-ascending">Price, Low to High</option>
          <option value="price-descending">Price, High to Low</option>
          <option value="created-descending">Date, New to Old</option>
          <option value="created-ascending">Date, Old to New</option>
        </select>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid--cols-4">
      {%- for product in collection.products -%}
        {%- render 'product-card', product: product -%}
      {%- else -%}
        <p style="grid-column: 1 / -1; text-align: center; padding: var(--spacing-12);">
          No products found in this collection.
        </p>
      {%- endfor -%}
    </div>

    <!-- Pagination -->
    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}

    <!-- Collection FAQ Section (if available) -->
    {%- if collection.metafields.collection.faq != blank -%}
      <div class="collection-template__faq" style="margin-top: var(--spacing-16);">
        <h2>Frequently Asked Questions</h2>
        {{ collection.metafields.collection.faq }}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  // Collection sort functionality
  document.getElementById('SortBy')?.addEventListener('change', function() {
    const url = new URL(window.location.href);
    url.searchParams.set('sort_by', this.value);
    window.location.href = url.toString();
  });
</script>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}
