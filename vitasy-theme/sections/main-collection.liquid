{%- style -%}
  .collection-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .collection-page__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .collection-page__title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
  }

  .collection-page__count {
    color: rgba(var(--color-foreground), 0.6);
    font-size: 0.95rem;
  }

  .collection-page__toolbar {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .collection-page__sort {
    padding: 0.5rem 1rem;
    border: 1px solid rgba(var(--color-foreground), 0.3);
    border-radius: 4px;
    background: transparent;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .collection-page__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .collection-page__pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3rem;
  }

  .collection-page__pagination a,
  .collection-page__pagination span {
    padding: 0.5rem 1rem;
    border: 1px solid rgba(var(--color-foreground), 0.3);
    border-radius: 4px;
    text-decoration: none;
    color: rgb(var(--color-foreground));
    transition: all 0.2s ease;
  }

  .collection-page__pagination a:hover {
    border-color: rgb(var(--color-foreground));
    background-color: rgba(var(--color-foreground), 0.05);
  }

  .collection-page__pagination .active {
    background-color: rgb(var(--color-accent-1));
    border-color: rgb(var(--color-accent-1));
    color: rgb(var(--color-background));
  }

  @media screen and (max-width: 1024px) {
    .collection-page__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .collection-page {
      padding: 2rem 1rem;
    }

    .collection-page__header {
      flex-direction: column;
      align-items: flex-start;
    }

    .collection-page__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
{%- endstyle -%}

<div class="collection-page">
  {% render 'breadcrumbs', collection: collection %}

  <div class="collection-page__header">
    <div>
      <h1 class="collection-page__title">{{ collection.title }}</h1>
      <p class="collection-page__count">{{ collection.products_count }} products</p>
    </div>

    <div class="collection-page__toolbar">
      <select class="collection-page__sort" id="SortBy">
        <option value="manual">Featured</option>
        <option value="best-selling">Best Selling</option>
        <option value="title-ascending">A-Z</option>
        <option value="title-descending">Z-A</option>
        <option value="price-ascending">Price: Low to High</option>
        <option value="price-descending">Price: High to Low</option>
        <option value="created-descending">Newest</option>
      </select>
    </div>
  </div>

  {% if collection.description != blank %}
    <div class="collection-page__description" style="margin-bottom: 2rem; line-height: 1.7;">
      {{ collection.description }}
    </div>
  {% endif %}

  {% if collection.products.size > 0 %}
    <div class="collection-page__grid">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <div class="collection-page__pagination">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}">Previous</a>
        {% endif %}

        {% for part in paginate.parts %}
          {% if part.is_link %}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {% else %}
            <span class="active">{{ part.title }}</span>
          {% endif %}
        {% endfor %}

        {% if paginate.next %}
          <a href="{{ paginate.next.url }}">Next</a>
        {% endif %}
      </div>
    {% endif %}
  {% else %}
    <div style="text-align: center; padding: 4rem 0;">
      <p>No products found in this collection.</p>
    </div>
  {% endif %}
</div>

<script>
  document.getElementById('SortBy')?.addEventListener('change', function() {
    const url = new URL(window.location.href);
    url.searchParams.set('sort_by', this.value);
    window.location.href = url.toString();
  });
</script>

{% schema %}
{
  "name": "Collection page",
  "settings": []
}
{% endschema %}
