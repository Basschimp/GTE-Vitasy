{%- assign products_per_page = section.settings.products_per_page | default: 12 -%}

<div class="collection-page container" data-section-id="{{ section.id }}">
  {% render 'breadcrumbs', collection: collection %}

  <h1 class="collection-title" style="font-size: 2rem; margin-bottom: 0.5rem;">{{ collection.title }}</h1>
  
  {% if collection.description != blank %}
    <div class="collection-description" style="margin-bottom: 2rem; color: #666;">
      {{ collection.description }}
    </div>
  {% endif %}

  <div class="collection-toolbar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <p class="product-count" style="color: #666;">
      {{ collection.products_count }} products
    </p>
    
    {% if section.settings.show_sorting %}
      <div class="collection-sort">
        <label for="sort-by" style="margin-right: 0.5rem;">Sort by:</label>
        <select id="sort-by" class="sort-select" style="padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px;">
          <option value="manual">Featured</option>
          <option value="best-selling">Best Selling</option>
          <option value="title-ascending">Alphabetically, A-Z</option>
          <option value="title-descending">Alphabetically, Z-A</option>
          <option value="price-ascending">Price, Low to High</option>
          <option value="price-descending">Price, High to Low</option>
          <option value="created-descending">Date, New to Old</option>
          <option value="created-ascending">Date, Old to New</option>
        </select>
      </div>
    {% endif %}
  </div>

  <div class="collection-products" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem;">
    {% paginate collection.products by products_per_page %}
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p class="no-products" style="grid-column: 1/-1; text-align: center; padding: 3rem; color: #666;">
          No products found in this collection.
        </p>
      {% endfor %}
      
      {% render 'pagination' %}
    {% endpaginate %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sortSelect = document.getElementById('sort-by');
    if (sortSelect) {
      sortSelect.addEventListener('change', function() {
        const url = new URL(window.location.href);
        url.searchParams.set('sort_by', this.value);
        window.location.href = url.toString();
      });
    }
  });
</script>

{% schema %}
{
  "name": "Collection page",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_sorting",
      "label": "Show sorting options",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filtering",
      "label": "Show filtering options",
      "default": true
    }
  ]
}
{% endschema %}
