{%- style -%}
  .product {
    max-width: 1400px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .product__container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .product__media {
    position: sticky;
    top: 100px;
    height: fit-content;
  }

  .product__media-main {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    background-color: rgba(var(--color-foreground), 0.05);
    margin-bottom: 1rem;
  }

  .product__media-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product__media-main:hover img {
    transform: scale(1.05);
  }

  .product__media-thumbnails {
    display: flex;
    gap: 0.5rem;
  }

  .product__media-thumbnail {
    width: 80px;
    aspect-ratio: 1;
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.2s ease;
  }

  .product__media-thumbnail.active {
    border-color: rgb(var(--color-accent-1));
  }

  .product__media-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product__info {
    display: flex;
    flex-direction: column;
  }

  .product__breadcrumbs {
    margin-bottom: 1rem;
    font-size: 0.9rem;
    color: rgba(var(--color-foreground), 0.6);
  }

  .product__breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .product__breadcrumbs a:hover {
    text-decoration: underline;
  }

  .product__title {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  .product__vendor {
    font-size: 0.9rem;
    color: rgba(var(--color-foreground), 0.6);
    margin-bottom: 1rem;
  }

  .product__price {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }

  .product__price-current {
    font-weight: 600;
    color: rgb(var(--color-accent-1));
  }

  .product__price-compare {
    text-decoration: line-through;
    opacity: 0.6;
    font-size: 1.2rem;
  }

  .product__price-badge {
    background-color: rgb(var(--color-accent-2));
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .product__reviews {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .product__reviews-stars {
    display: flex;
    color: #FFB800;
  }

  .product__reviews-count {
    font-size: 0.9rem;
    color: rgba(var(--color-foreground), 0.6);
  }

  .product__description {
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .product__description p {
    margin-bottom: 1rem;
  }

  .product__form {
    margin-bottom: 2rem;
  }

  .product__variants {
    margin-bottom: 1.5rem;
  }

  .product__variant-label {
    font-weight: 600;
    margin-bottom: 0.75rem;
    display: block;
  }

  .product__variant-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .product__variant-button {
    padding: 0.75rem 1.25rem;
    border: 1px solid rgba(var(--color-foreground), 0.3);
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .product__variant-button:hover {
    border-color: rgb(var(--color-foreground));
  }

  .product__variant-button.active {
    border-color: rgb(var(--color-accent-1));
    background-color: rgb(var(--color-accent-1));
    color: rgb(var(--color-background));
  }

  .product__variant-button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .product__quantity {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .product__quantity-label {
    font-weight: 600;
  }

  .product__quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid rgba(var(--color-foreground), 0.3);
    border-radius: 4px;
  }

  .product__quantity-button {
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
  }

  .product__quantity-button:hover {
    background-color: rgba(var(--color-foreground), 0.05);
  }

  .product__quantity-input {
    width: 50px;
    height: 40px;
    border: none;
    text-align: center;
    font-size: 1rem;
    font-weight: 600;
  }

  .product__quantity-input:focus {
    outline: none;
  }

  .product__buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .product__add-to-cart {
    width: 100%;
    padding: 1rem 2rem;
    background-color: rgb(var(--color-accent-1));
    color: rgb(var(--color-accent-2));
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .product__add-to-cart:hover {
    opacity: 0.9;
  }

  .product__add-to-cart:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .product__dynamic-checkout {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .shopify-payment-button__button {
    width: 100%;
    border-radius: 4px !important;
    font-weight: 600 !important;
  }

  .product__meta {
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
    padding-top: 1.5rem;
    margin-top: 1.5rem;
  }

  .product__meta-item {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }

  .product__meta-label {
    font-weight: 600;
    color: rgba(var(--color-foreground), 0.6);
  }

  .product__trust-badges {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 1.5rem;
    background-color: rgba(var(--color-foreground), 0.03);
    border-radius: 8px;
  }

  .product__trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
  }

  .product__trust-icon {
    width: 32px;
    height: 32px;
    color: rgb(var(--color-accent-1));
  }

  .product__trust-text {
    font-size: 0.8rem;
    font-weight: 600;
  }

  .product__cross-sell {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
  }

  .product__cross-sell-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .product__cross-sell-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  @media screen and (max-width: 1024px) {
    .product__container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .product__media {
      position: static;
    }

    .product__cross-sell-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .product {
      padding: 2rem 1rem;
    }

    .product__title {
      font-size: 1.75rem;
    }

    .product__trust-badges {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
{%- endstyle -%}

<div class="product">
  <div class="product__container">
    <div class="product__media">
      <div class="product__media-main">
        {% assign featured_image = product.selected_or_first_available_variant.featured_image | default: product.featured_image %}
        <img src="{{ featured_image | image_url: width: 1000 }}" alt="{{ featured_image.alt | escape }}" loading="eager" id="MainImage">
      </div>
      
      {% if product.media_count > 1 %}
        <div class="product__media-thumbnails">
          {% for media in product.media limit: 4 %}
            <div class="product__media-thumbnail{% if forloop.first %} active{% endif %}" data-media-id="{{ media.id }}">
              <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" loading="lazy">
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product__info">
      {% render 'breadcrumbs', product: product %}

      <h1 class="product__title">{{ product.title }}</h1>
      
      {% if product.vendor != blank %}
        <p class="product__vendor">{{ product.vendor }}</p>
      {% endif %}

      <div class="product__price">
        <span class="product__price-current" id="ProductPrice">
          {{ product.selected_or_first_available_variant.price | money }}
        </span>
        {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
          <span class="product__price-compare">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
          <span class="product__price-badge">
            {{ product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | times: 100 | divided_by: product.selected_or_first_available_variant.compare_at_price }}% OFF
          </span>
        {% endif %}
      </div>

      {% if settings.show_reviews %}
        <div class="product__reviews">
          <div class="product__reviews-stars" id="ProductStars">
            {% for i in (1..5) %}
              <svg width="16" height="16" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            {% endfor %}
          </div>
          <span class="product__reviews-count">
            <a href="#product-reviews">{{ product.metafields.reviews.rating_count }} reviews</a>
          </span>
        </div>
      {% endif %}

      <div class="product__description">
        {{ product.description }}
      </div>

      {% form 'product', product, class: 'product__form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        {% unless product.has_only_default_variant %}
          <div class="product__variants">
            {% for option in product.options_with_values %}
              <div class="product__variant-group">
                <label class="product__variant-label">{{ option.name }}</label>
                <div class="product__variant-options">
                  {% for value in option.values %}
                    <button 
                      type="button" 
                      class="product__variant-button{% if option.selected_value == value %} active{% endif %}"
                      data-option-name="{{ option.name }}"
                      data-option-value="{{ value }}"
                      {% unless product.variants | map: 'option1' | where: value | first %}disabled{% endunless %}
                    >
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endunless %}

        <div class="product__quantity">
          <label class="product__quantity-label" for="Quantity">Quantity</label>
          <div class="product__quantity-selector">
            <button type="button" class="product__quantity-button" id="QuantityMinus">−</button>
            <input type="number" id="Quantity" name="quantity" value="1" min="1" class="product__quantity-input">
            <button type="button" class="product__quantity-button" id="QuantityPlus">+</button>
          </div>
        </div>

        <div class="product__buttons">
          <button type="submit" name="add" class="product__add-to-cart" id="AddToCart" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
            </svg>
            {% if product.selected_or_first_available_variant.available %}
              {{ 'products.product.add_to_cart' | t }}
            {% else %}
              {{ 'products.product.sold_out' | t }}
            {% endif %}
          </button>

          {% if product.selected_or_first_available_variant.available %}
            <div class="product__dynamic-checkout">
              {{ form | payment_button }}
            </div>
          {% endif %}
        </div>
      {% endform %}

      <div class="product__meta">
        {% if product.type != blank %}
          <div class="product__meta-item">
            <span class="product__meta-label">Type:</span>
            <span>{{ product.type }}</span>
          </div>
        {% endif %}
        
        {% if product.tags.size > 0 %}
          <div class="product__meta-item">
            <span class="product__meta-label">Tags:</span>
            <span>{{ product.tags | join: ', ' }}</span>
          </div>
        {% endif %}

        {% if product.selected_or_first_available_variant.sku != blank %}
          <div class="product__meta-item">
            <span class="product__meta-label">SKU:</span>
            <span>{{ product.selected_or_first_available_variant.sku }}</span>
          </div>
        {% endif %}
      </div>

      <div class="product__trust-badges">
        <div class="product__trust-item">
          <svg class="product__trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          <span class="product__trust-text">Secure Checkout</span>
        </div>
        <div class="product__trust-item">
          <svg class="product__trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          <span class="product__trust-text">Free Returns</span>
        </div>
        <div class="product__trust-item">
          <svg class="product__trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <span class="product__trust-text">Fast Shipping</span>
        </div>
      </div>
    </div>
  </div>

  {% if section.settings.show_cross_sell %}
    <div class="product__cross-sell">
      <h2 class="product__cross-sell-title">You May Also Like</h2>
      <div class="product__cross-sell-grid">
        {% assign cross_sell_products = section.settings.cross_sell_collection.products | limit: 4 %}
        {% for product in cross_sell_products %}
          {% if product.id != current_product.id %}
            {% render 'product-card', product: product %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Quantity selector
    const quantityInput = document.getElementById('Quantity');
    const quantityMinus = document.getElementById('QuantityMinus');
    const quantityPlus = document.getElementById('QuantityPlus');

    if (quantityMinus && quantityInput) {
      quantityMinus.addEventListener('click', function() {
        const currentValue = parseInt(quantityInput.value);
        if (currentValue > 1) {
          quantityInput.value = currentValue - 1;
        }
      });
    }

    if (quantityPlus && quantityInput) {
      quantityPlus.addEventListener('click', function() {
        const currentValue = parseInt(quantityInput.value);
        quantityInput.value = currentValue + 1;
      });
    }

    // Variant selection
    const variantButtons = document.querySelectorAll('.product__variant-button');
    variantButtons.forEach(button => {
      button.addEventListener('click', function() {
        const optionName = this.dataset.optionName;
        const optionValue = this.dataset.optionValue;
        
        // Update active state
        const siblings = this.parentElement.querySelectorAll('.product__variant-button');
        siblings.forEach(btn => btn.classList.remove('active'));
        this.classList.add('active');

        // Update hidden input with variant ID
        const variantId = this.closest('form').querySelector(`input[name="id"]`);
        // In production, you'd fetch the correct variant ID based on all selected options
      });
    });

    // Media thumbnails
    const thumbnails = document.querySelectorAll('.product__media-thumbnail');
    const mainImage = document.getElementById('MainImage');
    
    thumbnails.forEach(thumb => {
      thumb.addEventListener('click', function() {
        thumbnails.forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        
        const img = this.querySelector('img');
        if (mainImage && img) {
          mainImage.src = img.src.replace('200x', '1000x');
        }
      });
    });

    // Add to cart AJAX
    const addToCartForm = document.querySelector('.product__form');
    const addToCartButton = document.getElementById('AddToCart');

    if (addToCartForm && addToCartButton) {
      addToCartForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const originalText = addToCartButton.innerHTML;
        
        addToCartButton.disabled = true;
        addToCartButton.innerHTML = '<span class="loading">Adding...</span>';

        try {
          const response = await fetch(window.routes.cart_add_url, {
            method: 'POST',
            body: formData
          });

          const data = await response.json();

          if (response.ok) {
            // Update cart count
            const event = new CustomEvent('cart:update', { detail: { count: data.item_count } });
            document.dispatchEvent(event);

            // Open cart drawer
            const cartDrawer = document.querySelector('.cart-drawer');
            if (cartDrawer) {
              cartDrawer.classList.add('cart-drawer--open');
              document.body.style.overflow = 'hidden';
            }

            addToCartButton.innerHTML = '<span>Added!</span>';
            setTimeout(() => {
              addToCartButton.disabled = false;
              addToCartButton.innerHTML = originalText;
            }, 1000);
          } else {
            throw new Error(data.description || 'Failed to add to cart');
          }
        } catch (error) {
          console.error('Error:', error);
          addToCartButton.disabled = false;
          addToCartButton.innerHTML = originalText;
          alert(window.cartStrings.error);
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_cross_sell",
      "label": "Show cross-sell products",
      "default": true
    },
    {
      "type": "collection",
      "id": "cross_sell_collection",
      "label": "Cross-sell collection"
    },
    {
      "type": "checkbox",
      "id": "show_subscription",
      "label": "Show subscription options",
      "default": true
    }
  ]
}
{% endschema %}
