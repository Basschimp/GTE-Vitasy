{%- comment -%}
  Main Product Section
{%- endcomment -%}

<div class="product-template" data-product-id="{{ product.id }}">
  <div class="container">
    {%- render 'breadcrumbs', current: product.title -%}

    <div class="product-template__grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--spacing-12); margin-top: var(--spacing-8);">
      <!-- Product Gallery -->
      <div class="product-template__gallery">
        {%- if product.featured_media -%}
          <img
            src="{{ product.featured_media | image_url: width: 800 }}"
            alt="{{ product.featured_media.alt | default: product.title }}"
            loading="eager"
            style="width: 100%; border-radius: var(--radius-lg);"
          >
        {%- endif -%}
      </div>

      <!-- Product Info -->
      <div class="product-template__info">
        <h1 class="product-template__title">{{ product.title }}</h1>

        {%- if settings.reviews_enabled -%}
          <div class="product-template__reviews" style="margin-bottom: var(--spacing-4);">
            <div class="jdgm-widget jdgm-preview-badge" data-uid="{{ product.id }}"></div>
          </div>
        {%- endif -%}

        <div class="product-template__price" style="font-size: var(--text-2xl); font-weight: 600; margin-bottom: var(--spacing-6);">
          {{ product.selected_or_first_available_variant.price | money }}
        </div>

        {%- if settings.subscription_enabled -%}
          {% render 'subscription-widget', product: product %}
        {%- endif -%}

        <div class="product-template__description" style="margin-bottom: var(--spacing-6);">
          {{ product.description }}
        </div>

        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          <button
            type="submit"
            class="btn btn--primary btn--lg btn--full-width"
            {% unless product.available %}disabled{% endunless %}
            data-add-to-cart
          >
            {%- if product.available -%}
              Add to Cart
            {%- else -%}
              Sold Out
            {%- endif -%}
          </button>
        </form>

        {%- if product.metafields.product.supplement_facts != blank -%}
          <div class="product-template__supplement-facts" style="margin-top: var(--spacing-8);">
            <h3>Supplement Facts</h3>
            {{ product.metafields.product.supplement_facts }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
