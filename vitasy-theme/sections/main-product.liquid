{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}

<div class="product-page container" data-section-id="{{ section.id }}" data-section-type="product">
  {% render 'breadcrumbs', product: product %}

  <div class="product-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin: 2rem 0;">
    <!-- Product Gallery -->
    <div class="product-media">
      {% if product.media.size > 0 %}
        <div class="product-main-image">
          <img 
            src="{{ product.featured_media | image_url: width: 800 }}" 
            alt="{{ product.featured_media.alt | escape }}"
            loading="eager"
            style="width: 100%; height: auto; border-radius: 4px;"
          >
        </div>
        {% if product.media.size > 1 %}
          <div class="product-thumbnails" style="display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap;">
            {% for media in product.media limit: 5 %}
              <button 
                class="thumbnail-btn" 
                data-media-id="{{ media.id }}"
                style="border: none; background: none; cursor: pointer; padding: 0;"
              >
                <img 
                  src="{{ media | image_url: width: 100 }}" 
                  alt="{{ media.alt | escape }}"
                  style="width: 80px; height: 80px; object-fit: cover; border-radius: 4px;"
                >
              </button>
            {% endfor %}
          </div>
        {% endif %}
      {% else %}
        <div class="product-placeholder" style="background: #f4f4f4; aspect-ratio: 1; display: flex; align-items: center; justify-content: center;">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <!-- Product Info -->
    <div class="product-info">
      <h1 class="product-title" style="font-size: 2rem; margin-bottom: 0.5rem;">{{ product.title }}</h1>
      
      {% if product.vendor != blank %}
        <p class="product-vendor" style="color: #666; margin-bottom: 0.5rem;">{{ product.vendor }}</p>
      {% endif %}

      <div class="product-price" style="font-size: 1.5rem; margin-bottom: 1rem;">
        <span id="price-{{ section.id }}">
          {% if product.compare_at_price > product.price %}
            <span style="text-decoration: line-through; color: #999;">{{ product.compare_at_price | money }}</span>
            <span style="color: var(--color-accent);">{{ product.price | money }}</span>
          {% else %}
            {{ product.price | money }}
          {% endif %}
        </span>
      </div>

      <!-- Variant Selector -->
      {% unless product.has_only_default_variant %}
        <div class="product-variants" style="margin-bottom: 1.5rem;">
          {% for option in product.options_with_values %}
            <div class="variant-option" style="margin-bottom: 1rem;">
              <label style="display: block; margin-bottom: 0.5rem; font-weight: bold;">{{ option.name }}</label>
              <div class="variant-buttons" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                {% for value in option.values %}
                  <button
                    type="button"
                    class="variant-btn{% if option.selected_value == value %} active{% endif %}"
                    data-option-name="{{ option.name }}"
                    data-option-value="{{ value | escape }}"
                    style="padding: 0.75rem 1rem; border: 1px solid #ddd; background: white; cursor: pointer; border-radius: 4px;"
                  >
                    {{ value }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endunless %}

      <!-- Quantity Selector -->
      <div class="product-quantity" style="margin-bottom: 1.5rem;">
        <label style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Quantity</label>
        <div class="quantity-selector" style="display: flex; align-items: center; gap: 0.5rem;">
          <button type="button" class="qty-minus" style="width: 40px; height: 40px; border: 1px solid #ddd; background: white; cursor: pointer; font-size: 1.25rem;">-</button>
          <input 
            type="number" 
            name="quantity" 
            value="1" 
            min="1" 
            class="qty-input"
            style="width: 60px; text-align: center; padding: 0.5rem; border: 1px solid #ddd;"
          >
          <button type="button" class="qty-plus" style="width: 40px; height: 40px; border: 1px solid #ddd; background: white; cursor: pointer; font-size: 1.25rem;">+</button>
        </div>
      </div>

      <!-- Subscription Widget -->
      {% if section.settings.show_subscription %}
        {% render 'subscription-widget', product: product %}
      {% endif %}

      <!-- Add to Cart Form -->
      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="{{ product_form_id }}" class="product-form">
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        
        <button 
          type="submit" 
          class="add-to-cart-btn button" 
          style="width: 100%; margin-bottom: 1rem;"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {% if current_variant.available %}
            Add to Cart
          {% else %}
            Sold Out
          {% endif %}
        </button>

        <!-- Dynamic Checkout Buttons -->
        {{ form | payment_button }}
      </form>

      <!-- Trust Badges -->
      <div class="trust-badges" style="display: flex; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap;">
        <div class="trust-badge" style="display: flex; align-items: center; gap: 0.5rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5z"/></svg>
          <span>Secure Checkout</span>
        </div>
        <div class="trust-badge" style="display: flex; align-items: center; gap: 0.5rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          <span>Free Returns</span>
        </div>
        <div class="trust-badge" style="display: flex; align-items: center; gap: 0.5rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span>Fast Shipping</span>
        </div>
      </div>

      <!-- Product Description -->
      {% if product.description != blank %}
        <div class="product-description" style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #eee;">
          <h3 style="margin-bottom: 1rem;">Description</h3>
          {{ product.description }}
        </div>
      {% endif %}

      <!-- Product Meta -->
      <div class="product-meta" style="margin-top: 1.5rem; color: #666; font-size: 0.875rem;">
        {% if product.type != blank %}
          <p>Type: <a href="{{ product.type | url_for_type }}">{{ product.type }}</a></p>
        {% endif %}
        {% if product.tags.size > 0 %}
          <p>Tags: 
            {% for tag in product.tags %}
              <a href="{{ tag | url_for_tag }}">{{ tag }}</a>{% unless forloop.last %}, {% endunless %}
            {% endfor %}
          </p>
        {% endif %}
      </div>

      <!-- Reviews -->
      {% if section.settings.show_reviews %}
        <div class="product-reviews" style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #eee;">
          <div id="judgeme_product_reviews_widget_span" data-sku="{{ product.selected_or_first_available_variant.sku }}" data-shop="{{ shop.domain }}"></div>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Cross-Sell Products -->
  {% if section.settings.show_cross_sell and recommendations.products_count > 0 %}
    <section class="cross-sell" style="margin-top: 3rem; padding: 2rem 0; border-top: 1px solid #eee;">
      <h2 style="text-align: center; margin-bottom: 2rem;">You May Also Like</h2>
      <div class="product-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem;">
        {% for recommendation in recommendations.products limit: section.settings.cross_sell_limit %}
          {% render 'product-card', product: recommendation %}
        {% endfor %}
      </div>
    </section>
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const productForm = document.getElementById('{{ product_form_id }}');
    const variantButtons = document.querySelectorAll('.variant-btn');
    const qtyMinus = document.querySelector('.qty-minus');
    const qtyPlus = document.querySelector('.qty-plus');
    const qtyInput = document.querySelector('.qty-input');

    // Variant selection
    variantButtons.forEach(button => {
      button.addEventListener('click', function() {
        const optionName = this.dataset.optionName;
        const optionValue = this.dataset.optionValue;
        
        // Update active state
        const siblings = this.parentElement.querySelectorAll('.variant-btn');
        siblings.forEach(btn => btn.classList.remove('active'));
        this.classList.add('active');
        
        // Update hidden input with selected variant ID
        // This would need to be connected to your variant logic
      });
    });

    // Quantity controls
    qtyMinus.addEventListener('click', function() {
      const currentValue = parseInt(qtyInput.value);
      if (currentValue > 1) {
        qtyInput.value = currentValue - 1;
      }
    });

    qtyPlus.addEventListener('click', function() {
      const currentValue = parseInt(qtyInput.value);
      qtyInput.value = currentValue + 1;
    });

    // AJAX add to cart
    productForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const formData = new FormData(productForm);
      
      fetch(window.routes.cart_add_url, {
        method: 'POST',
        body: formData,
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.status === 'ok') {
          // Open cart drawer
          document.querySelector('[data-cart-drawer]').classList.add('is-open');
          // Update cart count
          updateCartCount();
        } else {
          alert(data.description || 'Error adding to cart');
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('Error adding to cart');
      });
    });
  });

  function updateCartCount() {
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        document.querySelectorAll('.cart-count').forEach(el => {
          el.textContent = cart.item_count;
        });
      });
  }
</script>
