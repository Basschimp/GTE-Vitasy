<header class="header" role="banner">
  {%- if section.settings.announcement_bar_enabled -%}
    <div class="header__announcement-bar">
      <div class="container">
        <p>{{ section.settings.announcement_bar_text }}</p>
      </div>
    </div>
  {%- endif -%}
  
  <div class="header__main">
    <div class="container header__container">
      <!-- Mobile Menu Toggle -->
      <button 
        class="mobile-menu-toggle" 
        aria-label="Toggle menu"
        aria-expanded="false"
        id="MobileMenuToggle"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
      
      <!-- Logo -->
      <div class="header__logo">
        <a href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            <img 
              src="{{ section.settings.logo | image_url: width: 200 }}" 
              alt="{{ shop.name }}"
              width="{{ section.settings.logo.width }}"
              height="{{ section.settings.logo.height }}"
              loading="eager"
            >
          {%- else -%}
            <span style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 700; color: var(--color-primary-navy);">
              {{ shop.name }}
            </span>
          {%- endif -%}
        </a>
      </div>
      
      <!-- Desktop Navigation -->
      <nav class="header__nav" role="navigation" aria-label="Primary navigation">
        <ul class="header__nav-list">
          {%- for link in section.settings.menu.links -%}
            <li class="header__nav-item">
              <a 
                href="{{ link.url }}" 
                class="header__nav-link"
                {% if link.child_active %}aria-current="page"{% endif %}
              >
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
      
      <!-- Utilities -->
      <div class="header__utilities">
        <!-- Search -->
        <button 
          class="header__utility-btn" 
          aria-label="Search"
          id="SearchToggle"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
        
        <!-- Account -->
        <a 
          href="{{ routes.account_url }}" 
          class="header__utility-btn"
          aria-label="Account"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
        
        <!-- Cart -->
        <button 
          class="header__utility-btn" 
          aria-label="Cart"
          id="CartToggle"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span class="header__cart-count" id="CartCount" data-count="{{ cart.item_count }}">
            {{ cart.item_count }}
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "announcement_bar_enabled",
      "label": "Enable Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_bar_text",
      "label": "Announcement Text",
      "default": "Free shipping on orders over $50"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Primary Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
