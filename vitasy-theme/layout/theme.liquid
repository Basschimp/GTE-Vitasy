<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#102A43">
    <link rel="canonical" href="{{ canonical_url }}">
    
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    
    {%- unless settings.type_heading_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}
    
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    
    {% render 'meta-tags' %}
    {% render 'structured-data' %}
    
    <!-- Preload critical fonts -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700&family=Inter:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700&family=Inter:wght@400;500;600&display=swap">
    </noscript>
    
    <!-- Theme CSS -->
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    
    <!-- Judge.me Reviews -->
    {%- if settings.reviews_enabled and settings.judge_me_public_key -%}
      <script async defer src="https://cdn.judge.me/review-widgets/judge-me-review-widget-loader.js?shopUrl={{ shop.url }}&publicKey={{ settings.judge_me_public_key }}"></script>
    {%- endif -%}
    
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    
    <!-- Klaviyo Integration -->
    {%- if settings.klaviyo_public_key -%}
      <script async type="text/javascript" src="//static.klaviyo.com/onsite/js/klaviyo.js?company_id={{ settings.klaviyo_public_key }}"></script>
    {%- endif -%}
  </head>

  <body>
    <a class="skip-to-content" href="#MainContent">Skip to content</a>
    
    <!-- Cart Drawer Overlay -->
    <div class="cart-drawer__overlay" id="CartOverlay"></div>
    
    <!-- Cart Drawer -->
    {% render 'cart-drawer' %}
    
    <!-- Mobile Menu Overlay -->
    <div class="mobile-menu__overlay" id="MobileMenuOverlay"></div>
    
    <!-- Mobile Menu -->
    {% render 'mobile-menu' %}
    
    <!-- Header -->
    {% section 'header' %}
    
    <!-- Main Content -->
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    
    <!-- Footer -->
    {% section 'footer' %}
    
    <!-- Theme JavaScript -->
    {{ 'theme.js' | asset_url | script_tag }}
    
    <!-- GA4 Analytics -->
    {%- if settings.analytics_ga4_id -%}
      <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.analytics_ga4_id }}"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{{ settings.analytics_ga4_id }}');
      </script>
    {%- endif -%}
    
    <!-- Custom Analytics Script -->
    {%- if settings.analytics_custom_script != blank -%}
      {{ settings.analytics_custom_script }}
    {%- endif -%}
  </body>
</html>
