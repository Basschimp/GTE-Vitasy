{%- comment -%}
  Mobile Menu Snippet
  Renders the mobile navigation menu
{%- endcomment -%}

<div class="mobile-menu" id="MobileMenu" role="dialog" aria-modal="true" aria-labelledby="MobileMenuTitle">
  <div class="mobile-menu__header">
    <div class="header__logo">
      <a href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          <img 
            src="{{ section.settings.logo | image_url: width: 150 }}" 
            alt="{{ shop.name }}"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
          >
        {%- else -%}
          <span style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--color-primary-navy);">
            {{ shop.name }}
          </span>
        {%- endif -%}
      </a>
    </div>
    
    <button class="mobile-menu__close" aria-label="Close menu" id="MobileMenuClose">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  
  <nav class="mobile-menu__nav" role="navigation" aria-label="Mobile navigation">
    <ul class="mobile-menu__nav-list">
      {%- for link in section.settings.menu.links -%}
        <li class="mobile-menu__nav-item">
          <a 
            href="{{ link.url }}" 
            class="mobile-menu__nav-link"
            {% if link.child_active %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>
  
  <div style="margin-top: var(--spacing-8); padding-top: var(--spacing-8); border-top: 1px solid var(--color-border);">
    <a 
      href="{{ routes.account_url }}" 
      class="mobile-menu__nav-link"
      style="display: flex; align-items: center; gap: var(--spacing-3);"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      Account
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Mobile Menu",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Primary Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
