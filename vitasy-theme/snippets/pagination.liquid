{%- liquid
  assign total_pages = paginate.pages
  assign current_page = paginate.current_page
-%}

{%- if total_pages > 1 -%}
  <nav class="pagination" aria-label="Pagination" style="margin-top: 2rem;">
    <ul class="pagination-list" style="display: flex; justify-content: center; gap: 0.5rem; list-style: none; padding: 0; margin: 0;">
      {%- if paginate.previous -%}
        <li class="pagination-item">
          <a href="{{ paginate.previous.url }}" class="pagination-link" style="display: block; padding: 0.75rem 1rem; border: 1px solid #ddd; text-decoration: none; color: var(--color-text);">&laquo; Previous</a>
        </li>
      {%- else -%}
        <li class="pagination-item">
          <span class="pagination-link disabled" style="display: block; padding: 0.75rem 1rem; border: 1px solid #eee; color: #ccc; cursor: not-allowed;">&laquo; Previous</span>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li class="pagination-item">
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="pagination-link" style="display: block; padding: 0.75rem 1rem; border: 1px solid #ddd; text-decoration: none; color: var(--color-text);">{{ part.title }}</a>
          {%- else -%}
            {%- if part.title == current_page -%}
              <span class="pagination-link active" style="display: block; padding: 0.75rem 1rem; border: 1px solid var(--color-accent); background: var(--color-accent); color: white; font-weight: bold;">{{ part.title }}</span>
            {%- else -%}
              <span class="pagination-link" style="display: block; padding: 0.75rem 1rem; border: 1px solid #eee; color: #999;">{{ part.title }}</span>
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next -%}
        <li class="pagination-item">
          <a href="{{ paginate.next.url }}" class="pagination-link" style="display: block; padding: 0.75rem 1rem; border: 1px solid #ddd; text-decoration: none; color: var(--color-text);">Next &raquo;</a>
        </li>
      {%- else -%}
        <li class="pagination-item">
          <span class="pagination-link disabled" style="display: block; padding: 0.75rem 1rem; border: 1px solid #eee; color: #ccc; cursor: not-allowed;">Next &raquo;</span>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
