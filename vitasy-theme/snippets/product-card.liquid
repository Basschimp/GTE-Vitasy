{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign on_sale = true -%}
{%- endif -%}

<div class="product-card" style="position: relative;">
  {% if on_sale %}
    <span class="sale-badge" style="position: absolute; top: 0.5rem; left: 0.5rem; background: #ff4757; color: white; padding: 0.25rem 0.5rem; font-size: 0.75rem; border-radius: 2px; z-index: 1;">Sale</span>
  {% endif %}
  
  <a href="{{ product.url }}" class="product-card-link" style="display: block; text-decoration: none; color: inherit;">
    <div class="product-card-image" style="aspect-ratio: 1; overflow: hidden; background: #f4f4f4; margin-bottom: 1rem;">
      {% if product.featured_media %}
        <img 
          src="{{ product.featured_media | image_url: width: 400 }}" 
          alt="{{ product.featured_media.alt | escape }}"
          loading="lazy"
          style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;"
          onmouseover="this.style.transform='scale(1.05)'"
          onmouseout="this.style.transform='scale(1)'"
        >
      {% else %}
        {{ 'product-1' | placeholder_svg_tag }}
      {% endif %}
    </div>
    
    <h3 class="product-card-title" style="font-size: 1rem; margin-bottom: 0.5rem; line-height: 1.3;">{{ product.title }}</h3>
    
    <div class="product-card-price" style="margin-bottom: 0.5rem;">
      {% if on_sale %}
        <span style="text-decoration: line-through; color: #999; margin-right: 0.5rem;">{{ product.compare_at_price | money }}</span>
        <span style="color: var(--color-accent);">{{ product.price | money }}</span>
      {% else %}
        {{ product.price | money }}
      {% endif %}
    </div>
    
    {% if product.reviews.size > 0 %}
      <div class="product-card-reviews" style="color: #ffc107; font-size: 0.875rem;">
        {% for i in (1..5) %}
          {% if i <= product.metafields.reviews.rating.value %}★{% else %}☆{% endif %}
        {% endfor %}
        <span style="color: #666;">({{ product.reviews.size }})</span>
      </div>
    {% endif %}
  </a>
  
  <button 
    type="button" 
    class="quick-add-btn" 
    data-product-id="{{ product.id }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    style="width: 100%; padding: 0.75rem; background: var(--color-accent); color: var(--color-button-text); border: none; cursor: pointer; font-size: 0.875rem; transition: opacity 0.2s;"
    onmouseover="this.style.opacity='0.9'"
    onmouseout="this.style.opacity='1'"
  >
    Quick Add
  </button>
</div>
