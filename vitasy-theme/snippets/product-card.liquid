{%- style -%}
  .product-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    group: product-card;
  }

  .product-card__media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    background-color: rgba(var(--color-foreground), 0.05);
    margin-bottom: 1rem;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .product-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background-color: rgb(var(--color-accent-2));
    color: #fff;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    z-index: 1;
  }

  .product-card__quick-add {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    border: none;
    padding: 0.75rem;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease;
    z-index: 1;
  }

  .product-card:hover .product-card__quick-add {
    opacity: 1;
    transform: translateY(0);
  }

  .product-card__quick-add:hover {
    background-color: rgb(var(--color-accent-1));
    color: rgb(var(--color-accent-2));
  }

  .product-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .product-card__title {
    font-size: 0.95rem;
    font-weight: 500;
    margin: 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__vendor {
    font-size: 0.8rem;
    color: rgba(var(--color-foreground), 0.6);
    margin: 0;
  }

  .product-card__price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .product-card__price-current {
    font-weight: 600;
    font-size: 1rem;
  }

  .product-card__price-compare {
    text-decoration: line-through;
    opacity: 0.6;
    font-size: 0.9rem;
  }

  .product-card__reviews {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }

  .product-card__stars {
    display: flex;
    color: #FFB800;
  }

  .product-card__stars svg {
    width: 12px;
    height: 12px;
  }

  .product-card__rating {
    font-size: 0.75rem;
    color: rgba(var(--color-foreground), 0.6);
  }
{%- endstyle -%}

<a href="{{ product.url }}" class="product-card">
  <div class="product-card__media">
    {% if product.compare_at_price > product.price %}
      <span class="product-card__badge">{{ 'products.product.on_sale' | t }}</span>
    {% endif %}
    
    {% if product.featured_image %}
      <img 
        src="{{ product.featured_image | image_url: width: 500 }}" 
        alt="{{ product.featured_image.alt | escape }}"
        loading="lazy"
        class="product-card__image"
      >
    {% else %}
      <div class="product-card__placeholder" style="display:flex;align-items:center;justify-content:center;height:100%;color:rgba(var(--color-foreground),0.3);">
        <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
      </div>
    {% endif %}

    <button type="button" class="product-card__quick-add" data-product-id="{{ product.id }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}">
      {{ 'general.cart.add' | t }}
    </button>
  </div>

  <div class="product-card__info">
    <p class="product-card__vendor">{{ product.vendor }}</p>
    <h3 class="product-card__title">{{ product.title }}</h3>
    
    <div class="product-card__price">
      <span class="product-card__price-current">{{ product.selected_or_first_available_variant.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
    </div>

    {% if product.metafields.reviews.rating.value != blank %}
      <div class="product-card__reviews">
        <div class="product-card__stars">
          {% assign rating = product.metafields.reviews.rating.value | round: 0 %}
          {% for i in (1..5) %}
            <svg fill="{% if i <= rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
            </svg>
          {% endfor %}
        </div>
        <span class="product-card__rating">({{ product.metafields.reviews.rating_count }})</span>
      </div>
    {% endif %}
  </div>
</a>

<script>
  document.querySelectorAll('.product-card__quick-add').forEach(button => {
    button.addEventListener('click', async function(e) {
      e.preventDefault();
      e.stopPropagation();
      
      const variantId = this.dataset.variantId;
      const originalText = this.textContent;
      
      this.disabled = true;
      this.textContent = 'Adding...';

      try {
        const formData = new FormData();
        formData.append('id', variantId);
        formData.append('quantity', 1);

        const response = await fetch(window.routes.cart_add_url, {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (response.ok) {
          this.textContent = 'Added!';
          
          // Update cart count
          const event = new CustomEvent('cart:update', { detail: { count: data.item_count } });
          document.dispatchEvent(event);

          // Open cart drawer
          const cartDrawer = document.getElementById('CartDrawer');
          if (cartDrawer) {
            cartDrawer.classList.add('cart-drawer--open');
            document.body.style.overflow = 'hidden';
          }

          setTimeout(() => {
            this.textContent = originalText;
            this.disabled = false;
          }, 1000);
        }
      } catch (error) {
        console.error('Error:', error);
        this.textContent = originalText;
        this.disabled = false;
        alert(window.cartStrings.error);
      }
    });
  });
</script>
