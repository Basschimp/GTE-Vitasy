{%- comment -%}
  Cart Drawer Snippet
  Renders the cart drawer with items, subtotal, and checkout button
{%- endcomment -%}

<div class="cart-drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
  <div class="cart-drawer__header">
    <h2 class="cart-drawer__title" id="CartDrawerTitle">Your Cart</h2>
    <button class="cart-drawer__close" aria-label="Close cart" id="CartDrawerClose">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  
  <div class="cart-drawer__items" id="CartDrawerItems">
    {%- if cart.item_count > 0 -%}
      {%- for item in cart.items -%}
        <div class="cart-item" data-line-item="{{ forloop.index }}">
          <img 
            src="{{ item.image | image_url: width: 160 }}" 
            alt="{{ item.title }}"
            class="cart-item__image"
            loading="lazy"
            width="80"
            height="80"
          >
          
          <div class="cart-item__details">
            <h3 class="cart-item__title">{{ item.product.title }}</h3>
            
            {%- if item.variant.title != 'Default Title' -%}
              <p class="cart-item__variant">{{ item.variant.title }}</p>
            {%- endif -%}
            
            <p class="cart-item__price">{{ item.final_line_price | money }}</p>
            
            <div class="cart-item__quantity">
              <button 
                class="cart-item__qty-btn" 
                aria-label="Decrease quantity"
                data-qty-update
                data-line="{{ forloop.index }}"
                data-qty="{{ item.quantity | minus: 1 }}"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
              
              <input 
                type="number" 
                class="cart-item__qty-input" 
                value="{{ item.quantity }}" 
                min="1"
                data-qty-input
                data-line="{{ forloop.index }}"
              >
              
              <button 
                class="cart-item__qty-btn" 
                aria-label="Increase quantity"
                data-qty-update
                data-line="{{ forloop.index }}"
                data-qty="{{ item.quantity | plus: 1 }}"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
            </div>
            
            <button 
              class="cart-item__remove"
              data-remove-item
              data-line="{{ forloop.index }}"
            >
              Remove
            </button>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <p style="text-align: center; padding: var(--spacing-12); color: var(--color-text);">
        Your cart is empty.
      </p>
    {%- endif -%}
  </div>
  
  {%- if cart.item_count > 0 -%}
    <div class="cart-drawer__footer">
      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <span data-cart-subtotal>{{ cart.total_price | money }}</span>
      </div>
      
      <p style="font-size: var(--text-xs); color: var(--color-text); opacity: 0.8; margin-bottom: var(--spacing-4);">
        Shipping and taxes calculated at checkout.
      </p>
      
      <a 
        href="{{ routes.cart_url }}" 
        class="btn btn--primary btn--lg cart-drawer__checkout-btn"
      >
        Checkout
      </a>
      
      {%- if section.settings.show_subscription_note -%}
        <p style="font-size: var(--text-xs); text-align: center; margin-top: var(--spacing-4); color: var(--color-secondary-green);">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle;">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Subscribe & Save up to {{ settings.subscription_discount }}% on eligible items
        </p>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_subscription_note",
      "label": "Show Subscription Note",
      "default": true
    }
  ]
}
{% endschema %}
