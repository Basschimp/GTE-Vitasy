<div class="cart-drawer{% if cart.item_count == 0 %} cart-drawer--empty{% endif %}" id="CartDrawer">
  <div class="cart-drawer__overlay" data-close-cart></div>
  
  <div class="cart-drawer__content">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">Your Cart ({{ cart.item_count }})</h2>
      <button class="cart-drawer__close" data-close-cart aria-label="Close cart">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    {% if cart.item_count > 0 %}
      <div class="cart-drawer__items">
        {% for item in cart.items %}
          <div class="cart-drawer__item" data-line-item="{{ forloop.index }}">
            <div class="cart-drawer__item-image">
              <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.title | escape }}" loading="lazy">
            </div>
            
            <div class="cart-drawer__item-details">
              <h3 class="cart-drawer__item-title">
                <a href="{{ item.url }}">{{ item.product.title }}</a>
              </h3>
              
              {% unless item.variant.title contains 'Default' %}
                <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
              {% endunless %}
              
              <p class="cart-drawer__item-price">{{ item.final_line_price | money }}</p>
              
              <div class="cart-drawer__item-quantity">
                <button class="cart-drawer__quantity-btn" data-quantity-minus data-index="{{ forloop.index }}">−</button>
                <input type="number" class="cart-drawer__quantity-input" value="{{ item.quantity }}" min="1" data-quantity-input data-index="{{ forloop.index }}">
                <button class="cart-drawer__quantity-btn" data-quantity-plus data-index="{{ forloop.index }}">+</button>
              </div>
              
              <button class="cart-drawer__item-remove" data-remove-item data-index="{{ forloop.index }}">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
                Remove
              </button>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="cart-drawer__footer">
        <div class="cart-drawer__subtotal">
          <span>Subtotal</span>
          <span class="cart-drawer__subtotal-price">{{ cart.total_price | money }}</span>
        </div>
        
        <p class="cart-drawer__shipping-note">{{ 'general.cart.shipping_calculated_at_checkout' | t }}</p>
        
        <button class="cart-drawer__checkout-btn" name="checkout">
          {{ 'general.cart.checkout' | t }}
        </button>
        
        <a href="{{ routes.cart_url }}" class="cart-drawer__view-cart">View Full Cart</a>
      </div>
    {% else %}
      <div class="cart-drawer__empty">
        <svg class="cart-drawer__empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
        <h3 class="cart-drawer__empty-title">{{ 'general.cart.empty' | t }}</h3>
        <p class="cart-drawer__empty-text">Looks like you haven't added anything to your cart yet.</p>
        <a href="{{ routes.all_products_collection_url }}" class="cart-drawer__continue-shopping">
          {{ 'general.cart.continue_shopping' | t }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{%- style -%}
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 450px;
    background-color: rgb(var(--color-background));
    z-index: 1000;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer--open {
    transform: translateX(0);
  }

  .cart-drawer__overlay {
    position: absolute;
    top: 0;
    left: -100%;
    width: calc(100vw - 450px);
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cart-drawer--open .cart-drawer__overlay {
    opacity: 1;
  }

  .cart-drawer__content {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }

  .cart-drawer__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
  }

  .cart-drawer__close {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: rgb(var(--color-foreground));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-drawer__items {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .cart-drawer__item {
    display: flex;
    gap: 1rem;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }

  .cart-drawer__item:last-child {
    border-bottom: none;
  }

  .cart-drawer__item-image {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    background-color: rgba(var(--color-foreground), 0.05);
  }

  .cart-drawer__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-drawer__item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cart-drawer__item-title {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
  }

  .cart-drawer__item-title a {
    color: rgb(var(--color-foreground));
    text-decoration: none;
  }

  .cart-drawer__item-variant {
    font-size: 0.85rem;
    color: rgba(var(--color-foreground), 0.6);
    margin: 0;
  }

  .cart-drawer__item-price {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
  }

  .cart-drawer__item-quantity {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
  }

  .cart-drawer__quantity-btn {
    width: 32px;
    height: 32px;
    border: 1px solid rgba(var(--color-foreground), 0.3);
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .cart-drawer__quantity-btn:hover {
    border-color: rgb(var(--color-foreground));
    background-color: rgba(var(--color-foreground), 0.05);
  }

  .cart-drawer__quantity-input {
    width: 40px;
    height: 32px;
    border: 1px solid rgba(var(--color-foreground), 0.3);
    border-radius: 4px;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .cart-drawer__quantity-input:focus {
    outline: none;
    border-color: rgb(var(--color-accent-1));
  }

  .cart-drawer__item-remove {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background: transparent;
    border: none;
    color: rgba(var(--color-foreground), 0.6);
    font-size: 0.8rem;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s ease;
  }

  .cart-drawer__item-remove:hover {
    color: #ff4444;
  }

  .cart-drawer__footer {
    padding: 1.5rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
    background-color: rgba(var(--color-foreground), 0.02);
  }

  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .cart-drawer__shipping-note {
    font-size: 0.85rem;
    color: rgba(var(--color-foreground), 0.6);
    margin: 0 0 1rem;
  }

  .cart-drawer__checkout-btn {
    width: 100%;
    padding: 1rem;
    background-color: rgb(var(--color-accent-1));
    color: rgb(var(--color-accent-2));
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s ease;
    margin-bottom: 0.75rem;
  }

  .cart-drawer__checkout-btn:hover {
    opacity: 0.9;
  }

  .cart-drawer__view-cart {
    display: block;
    text-align: center;
    color: rgb(var(--color-foreground));
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.75rem;
    border: 1px solid rgba(var(--color-foreground), 0.3);
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .cart-drawer__view-cart:hover {
    border-color: rgb(var(--color-foreground));
  }

  .cart-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    padding: 2rem;
  }

  .cart-drawer__empty-icon {
    width: 64px;
    height: 64px;
    color: rgba(var(--color-foreground), 0.3);
    margin-bottom: 1.5rem;
  }

  .cart-drawer__empty-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .cart-drawer__empty-text {
    color: rgba(var(--color-foreground), 0.6);
    margin: 0 0 1.5rem;
  }

  .cart-drawer__continue-shopping {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background-color: rgb(var(--color-accent-1));
    color: rgb(var(--color-accent-2));
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    transition: opacity 0.2s ease;
  }

  .cart-drawer__continue-shopping:hover {
    opacity: 0.9;
  }

  @media screen and (max-width: 500px) {
    .cart-drawer {
      max-width: 100%;
    }

    .cart-drawer__overlay {
      width: 100%;
      left: 0;
    }
  }
{%- endstyle -%}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const cartDrawer = document.getElementById('CartDrawer');
    const closeButtons = document.querySelectorAll('[data-close-cart]');
    
    // Close cart drawer
    closeButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        cartDrawer.classList.remove('cart-drawer--open');
        document.body.style.overflow = '';
      });
    });

    // Quantity controls
    document.querySelectorAll('[data-quantity-minus]').forEach(btn => {
      btn.addEventListener('click', async function() {
        const index = this.dataset.index;
        const input = document.querySelector(`[data-quantity-input][data-index="${index}"]`);
        const newQty = parseInt(input.value) - 1;
        
        if (newQty >= 1) {
          await updateCartItem(index, newQty);
        }
      });
    });

    document.querySelectorAll('[data-quantity-plus]').forEach(btn => {
      btn.addEventListener('click', async function() {
        const index = this.dataset.index;
        const input = document.querySelector(`[data-quantity-input][data-index="${index}"]`);
        const newQty = parseInt(input.value) + 1;
        
        await updateCartItem(index, newQty);
      });
    });

    // Remove item
    document.querySelectorAll('[data-remove-item]').forEach(btn => {
      btn.addEventListener('click', async function() {
        const index = this.dataset.index;
        await updateCartItem(index, 0);
      });
    });

    async function updateCartItem(line, quantity) {
      const formData = new FormData();
      formData.append('updates[]', quantity);
      
      try {
        const response = await fetch(window.routes.cart_update_url, {
          method: 'POST',
          body: formData
        });
        
        if (response.ok) {
          // Reload cart drawer content
          window.location.reload();
        }
      } catch (error) {
        console.error('Error updating cart:', error);
        alert(window.cartStrings.error);
      }
    }
  });
</script>
