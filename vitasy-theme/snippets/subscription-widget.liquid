{%- liquid
  assign subscription_discount = 10
-%}

<div class="subscription-widget" style="border: 1px solid #ddd; border-radius: 4px; padding: 1rem; margin-bottom: 1.5rem;">
  <h3 style="margin-bottom: 1rem; font-size: 1rem;">Choose how often</h3>
  
  <label class="subscription-option" style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; cursor: pointer;">
    <input 
      type="radio" 
      name="selling_plan" 
      value="one_time" 
      checked
      style="width: 18px; height: 18px;"
    >
    <div style="flex: 1;">
      <span style="font-weight: bold;">One-time purchase</span>
      <p style="margin: 0.25rem 0 0 0; color: #666; font-size: 0.875rem;">{{ product.price | money }}</p>
    </div>
  </label>
  
  <label class="subscription-option" style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer;">
    <input 
      type="radio" 
      name="selling_plan" 
      value="subscribe"
      style="width: 18px; height: 18px;"
    >
    <div style="flex: 1;">
      <span style="font-weight: bold;">Subscribe & Save {{ subscription_discount }}%</span>
      <p style="margin: 0.25rem 0 0 0; color: #666; font-size: 0.875rem;">{{ product.price | times: 0.9 | money }} every month</p>
    </div>
    <span class="save-badge" style="background: #22c55e; color: white; padding: 0.25rem 0.5rem; font-size: 0.75rem; border-radius: 2px;">Save {{ subscription_discount }}%</span>
  </label>
  
  <p class="subscription-benefits" style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #eee; font-size: 0.875rem; color: #666;">
    ✓ Skip or cancel anytime<br>
    ✓ Free shipping on subscriptions<br>
    ✓ Never run out of your essentials
  </p>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const subscriptionOptions = document.querySelectorAll('input[name="selling_plan"]');
    const variantInput = document.querySelector('input[name="id"]');
    
    subscriptionOptions.forEach(option => {
      option.addEventListener('change', function() {
        // Update selling plan based on selection
        if (this.value === 'subscribe') {
          // Apply subscription discount logic here
          console.log('Subscription selected');
        } else {
          console.log('One-time purchase selected');
        }
      });
    });
  });
</script>
