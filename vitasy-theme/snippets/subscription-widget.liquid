{%- comment -%}
  Subscription Widget Snippet
  Renders subscription options for products (Recharge integration)
  Accepts: product (object) - Product object from Shopify
{%- endcomment -%}

<div class="subscription-widget" data-subscription-widget>
  <div class="subscription-widget__header">
    <svg class="subscription-widget__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
    </svg>
    <h3 class="subscription-widget__title">Subscribe & Save {{ settings.subscription_discount }}%</h3>
  </div>
  
  <div class="subscription-widget__options">
    <!-- One-time Purchase -->
    <label class="subscription-option" data-subscription-option="onetime">
      <input 
        type="radio" 
        name="subscription_option" 
        value="onetime"
        checked
      >
      <span class="subscription-option__label">
        One-time purchase
        <span class="subscription-option__price">{{ product.selected_or_first_available_variant.price | money }}</span>
      </span>
    </label>
    
    <!-- Subscription Option -->
    <label class="subscription-option" data-subscription-option="subscribe">
      <input 
        type="radio" 
        name="subscription_option" 
        value="subscribe"
      >
      <span class="subscription-option__label">
        Subscribe & Save
        <span class="subscription-option__discount">{{ settings.subscription_discount }}% OFF</span>
        <span class="subscription-option__price">
          {{ product.selected_or_first_available_variant.price 
            | times: settings.subscription_discount 
            | divided_by: 100 
            | minus: product.selected_or_first_available_variant.price 
            | absolute 
            | money 
          }}
        </span>
      </span>
    </label>
  </div>
  
  {%- if settings.subscription_benefits != blank -%}
    <div class="subscription-widget__benefits" style="margin-top: var(--spacing-4); font-size: var(--text-xs); color: var(--color-text);">
      {{ settings.subscription_benefits }}
    </div>
  {%- endif -%}
</div>

<script>
  // Subscription option toggle
  document.querySelectorAll('[data-subscription-option]').forEach(option => {
    option.addEventListener('click', function() {
      document.querySelectorAll('[data-subscription-option]').forEach(o => {
        o.classList.remove('subscription-option--selected');
      });
      this.classList.add('subscription-option--selected');
      
      const input = this.querySelector('input[type="radio"]');
      if (input) input.checked = true;
    });
  });
</script>
