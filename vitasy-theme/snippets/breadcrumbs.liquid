<nav class="breadcrumbs" aria-label="Breadcrumbs">
  <ol class="breadcrumbs__list" style="display:flex;gap:0.5rem;list-style:none;padding:0;margin:0;font-size:0.9rem;">
    <li class="breadcrumbs__item">
      <a href="{{ routes.root_url }}" class="breadcrumbs__link" style="color:inherit;text-decoration:none;">
        {{ 'general.breadcrumbs.home' | t }}
      </a>
    </li>
    
    {% if collection %}
      <li class="breadcrumbs__separator" style="opacity:0.5;">/</li>
      <li class="breadcrumbs__item">
        <a href="{{ collection.url }}" class="breadcrumbs__link" style="color:inherit;text-decoration:none;">
          {{ collection.title }}
        </a>
      </li>
    {% endif %}
    
    {% if product %}
      <li class="breadcrumbs__separator" style="opacity:0.5;">/</li>
      <li class="breadcrumbs__item">
        <span class="breadcrumbs__current" style="opacity:0.6;" aria-current="page">
          {{ product.title }}
        </span>
      </li>
    {% endif %}
    
    {% if page %}
      <li class="breadcrumbs__separator" style="opacity:0.5;">/</li>
      <li class="breadcrumbs__item">
        <span class="breadcrumbs__current" style="opacity:0.6;" aria-current="page">
          {{ page.title }}
        </span>
      </li>
    {% endif %}
    
    {% if search %}
      <li class="breadcrumbs__separator" style="opacity:0.5;">/</li>
      <li class="breadcrumbs__item">
        <span class="breadcrumbs__current" style="opacity:0.6;" aria-current="page">
          Search
        </span>
      </li>
    {% endif %}
    
    {% if cart %}
      <li class="breadcrumbs__separator" style="opacity:0.5;">/</li>
      <li class="breadcrumbs__item">
        <span class="breadcrumbs__current" style="opacity:0.6;" aria-current="page">
          Cart
        </span>
      </li>
    {% endif %}
  </ol>
</nav>
